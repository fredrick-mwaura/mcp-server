{
  "server": {
    "command": "mcp-filesystem-server",
    "name": "File System Server",
    "protocol_versions": ["2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25", "2026-07-28"],
    "python_reference_version": "0.5.0",
    "rust_candidate_version": "0.1.0"
  },
  "configuration": {
    "MCP_FS_ROOTS": { "default": "current working directory", "type": "comma-separated or JSON array of paths" },
    "MCP_FS_MODE": { "default": "read-only", "enum": ["read-only", "read-write"] },
    "MCP_FS_TRANSPORT": { "default": "stdio", "enum": ["stdio", "streamable-http"] },
    "MCP_FS_LOG_LEVEL": { "default": "INFO", "type": "string" },
    "MCP_FS_LOG_FORMAT": { "default": "json", "enum": ["json", "text"] },
    "MCP_FS_MAX_READ_LINES": { "default": 200, "minimum": 1, "type": "integer" },
    "MCP_FS_MAX_READ_BYTES": { "default": 1000000, "minimum": 1, "type": "integer" },
    "MCP_FS_MAX_OUTPUT_BYTES": { "default": 1000000, "minimum": 1, "type": "integer" },
    "MCP_FS_MAX_WRITE_BYTES": { "default": 5000000, "minimum": 1, "type": "integer" },
    "MCP_FS_ALLOW_EXEC": { "default": false, "type": "boolean" },
    "MCP_FS_AUTH_MODE": { "default": "auto", "enum": ["auto", "bearer", "none"] },
    "MCP_FS_AUTH_TOKEN": { "default": null, "secret": true, "type": "string" },
    "MCP_FS_AUTH_TOKEN_FILE": { "default": null, "secret": true, "type": "path" },
    "MCP_FS_ALLOW_UNSAFE_REMOTE": { "default": false, "type": "boolean" },
    "MCP_FS_ALLOWED_HOSTS": { "default": [], "type": "comma-separated or JSON array of strings" },
    "MCP_FS_ALLOWED_ORIGINS": { "default": [], "type": "comma-separated or JSON array of strings" },
    "MCP_FS_MAX_HTTP_BODY_BYTES": { "default": 6000000, "minimum": 1, "type": "integer" },
    "MCP_FS_HOST": { "default": "127.0.0.1", "type": "string" },
    "MCP_FS_PORT": { "default": 8000, "maximum": 65535, "minimum": 1, "type": "integer" }
  },
  "tools": [
    "apply_patch",
    "delete_entry",
    "edit_block",
    "export_swebench_patch",
    "find_files",
    "git_diff",
    "git_status",
    "grep_search",
    "list_directory",
    "read_file",
    "revert_file",
    "run_test",
    "symbol_outline",
    "write_file"
  ],
  "stable_error_codes": [
    "edit_target_error",
    "execution_disabled",
    "file_too_large",
    "git_command_error",
    "git_repo_outside_root",
    "internal_error",
    "invalid_argument",
    "invalid_patch_path",
    "not_a_git_repo",
    "path_not_a_directory",
    "path_not_a_file",
    "path_not_allowed",
    "path_not_found",
    "patch_conflict",
    "read_only_mode",
    "syntax_error"
  ]
}
