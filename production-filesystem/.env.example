# -----------------------------------------------------------------------------
# Example environment configuration for the MCP filesystem server (Phase 1).
#
# Copy to a real .env, or better: set these in your shell / opencode's
# `environment` map inside opencode.json. THIS FILE MUST NEVER CONTAIN REAL
# SECRETS - it is documentation.
# -----------------------------------------------------------------------------

# Comma-separated list of allowed directory roots (the ONLY places the server
# will touch). Paths may contain spaces; each item is trimmed. You may also
# pass a JSON array:  ["/data/a", "/data/b"].
# If unset, the server defaults to the directory it was launched from.
MCP_FS_ROOTS=/Users/me/projects,/Users/me/shared

# Phase 1 only exposes read-only tools, but the knob exists now so Phase 3
# (write tools) honors it from day one. Valid values: read-only | read-write.
MCP_FS_MODE=read-only

# stdio (opencode and other local MCP clients) is the Phase 1 transport.
# (streamable-http arrives in Phase 4.)
MCP_FS_TRANSPORT=stdio

# Structured logs are JSON by default (machine-readable). Use "text" for the
# pretty human format you saw in Lesson 1.
MCP_FS_LOG_FORMAT=json
MCP_FS_LOG_LEVEL=INFO
