# Workspace boundary (JSON array or comma-separated paths).
MCP_FS_ROOTS=/workspace

# Least privilege defaults.
MCP_FS_MODE=read-only
MCP_FS_ALLOW_EXEC=false

# stdio needs no application authentication. For HTTP, auto requires bearer
# authentication on non-loopback binds and permits unauthenticated loopback.
MCP_FS_TRANSPORT=stdio
MCP_FS_HOST=127.0.0.1
MCP_FS_PORT=8000
MCP_FS_AUTH_MODE=auto
# Inject one at runtime for non-loopback HTTP; never commit a real token.
# MCP_FS_AUTH_TOKEN_FILE=/run/secrets/mcp_fs_token
MCP_FS_ALLOW_UNSAFE_REMOTE=false
# MCP_FS_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# MCP_FS_ALLOWED_ORIGINS=http://localhost:3000

# Resource ceilings.
MCP_FS_MAX_READ_LINES=200
MCP_FS_MAX_READ_BYTES=1000000
MCP_FS_MAX_OUTPUT_BYTES=1000000
MCP_FS_MAX_WRITE_BYTES=5000000
MCP_FS_MAX_HTTP_BODY_BYTES=4000000
MCP_FS_MAX_TEST_TIMEOUT=300

MCP_FS_LOG_FORMAT=json
MCP_FS_LOG_LEVEL=INFO
